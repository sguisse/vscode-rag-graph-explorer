# =============================================================================
# skill.env — Central configuration for jqassistant + graph-rag tooling
# =============================================================================
# Source this file before running any script:
#   source .github/skills/rvng-jqassistant-analysis/scripts/skill.env
#
# All variables have sensible defaults and can be overridden by the environment.
# =============================================================================

JQA_SKILL_NAME="rvng-jqassistant-analysis"
JQA_SKILL_PATH_VS_ROOT=".github/skills/${JQA_SKILL_NAME}"
JQA_GRAPH_RAG_TOOL_PATH_VS_ROOT="${JQA_SKILL_PATH_VS_ROOT}/tool-graph-rag/git-clone"

# ── Python venvs ──────────────────────────────────────────────────────────────
# Interpreter for jqassistant helper scripts (stdlib only; no heavy deps needed).
# Path is relative to the skill scripts folder when not absolute.
JQA_PYTHON3_JQASSISTANT_CMD="${JQA_SKILL_PATH_VS_ROOT}/scripts/.venv/bin/python"

# Interpreter for the graph-rag tool (neo4j, sentence-transformers, fastmcp …).
# Path is relative to GRAPH_RAG_DIR when not absolute.
JQA_PYTHON3_GRAPH_RAG_CMD="${JQA_GRAPH_RAG_TOOL_PATH_VS_ROOT}/.venv/bin/python"

# Preferred Python version for venv creation (pydantic/fastmcp need < 3.14)
JQA_PYTHON3_JQASSISTANT_CREATOR_VERSION="python3.12"

# ── Neo4j / jqassistant store ─────────────────────────────────────────────────
JQA_HOST="localhost"
JQA_HTTP_PORT=7777
JQA_BOLT_PORT=7688
JQA_URI="bolt://${JQA_HOST}:${JQA_BOLT_PORT}"
JQA_USER=""
JQA_PASSWORD=""

# Maven profile that activates jqassistant
JQA_MAVEN_PROFILE="jqassistant,test-coverage"

# Maven system properties passed to jqassistant:server to enable the Bolt connector
JQA_MVN_PARAMS="-P${JQA_MAVEN_PROFILE}
-Djqassistant.store.embedded.connector-enabled=true
-Djqassistant.store.embedded.listen-address=${JQA_HOST}
-Djqassistant.store.embedded.bolt-port=${JQA_BOLT_PORT}
-Djqassistant.store.embedded.http-port=${JQA_HTTP_PORT}
-Djqassistant.server.embedded.bolt-uri=${JQA_URI}
"

# ── MCP server ────────────────────────────────────────────────────────────────
JQA_MCP_HOST=127.0.0.1
JQA_MCP_PORT=8800
JQA_MCP_LOG="/tmp/mcp-server.log"
JQA_MCP_PID_FILE="/tmp/mcp-server.pid"
# ── MCP server URL (for verify scripts that test reachability)
JQA_MCP_URL="http://${JQA_MCP_HOST}:${JQA_MCP_PORT}"


# ── Neo4j server logs / PID ───────────────────────────────────────────────────
JQA_SERVER_LOG="/tmp/jqa-server.log"
JQA_SERVER_PID_FILE="/tmp/jqa-server.pid"

# ── Sentence-transformer model ────────────────────────────────────────────────
# HuggingFace model ID used when cloning / downloading the model
JQA_SENTENCE_TRANSFORMER_HF_REPO="sentence-transformers/all-MiniLM-L6-v2"

# Path to a locally cached sentence-transformers model.
# If the directory exists, scripts will use it to avoid network downloads.
# Default: models/all-MiniLM-L6-v2 relative to GRAPH_RAG_DIR.
JQA_SENTENCE_TRANSFORMER_LOCAL_MODEL="models/all-MiniLM-L6-v2"



# ── LLM backends ─────────────────────────────────────────────────────────────
# OpenAI
# JQA_OPENAI_API_KEY=sk-...
JQA_OPENAI_MODEL="gpt-4o"

# Ollama
JQA_OLLAMA_HOST="localhost"
JQA_OLLAMA_PORT=11434
JQA_OLLAMA_BASE_URL="http://${JQA_OLLAMA_HOST}:${JQA_OLLAMA_PORT}"
JQA_OLLAMA_MODEL="deepseek-coder:6.7b"

# DeepSeek
# JQA_DEEPSEEK_API_KEY=...
JQA_DEEPSEEK_MODEL="deepseek-chat"

# Copilot
JQA_COPILOT_MODEL="gpt-5-mini"
JQA_COPILOT_MODEL_EFFORT="medium"


# Generic CLI LLM wrapper (gemini, copilot, etc.)
JQA_LLM_CLI_CMD="gemini"
JQA_LLM_CLI_PARAMS=""
JQA_LLM_CLI_TIMEOUT="300"

# ── jqassistant venv (separate from graph-rag venv) ──────────────────────────
# Path is relative to the project root.
JQA_VENV_DIR=".github/skills/rvng-jqassistant-analysis/scripts/.venv"

# ── graph-rag source repository ───────────────────────────────────────────────
JQA_GRAPH_RAG_REPO_URL="https://github.com/sguisse/jqassistant-graph-rag.git"

# ── SSL / corporate network ───────────────────────────────────────────────────
# Set to path of your CA bundle if HuggingFace / PyPI downloads fail with SSL errors.
# Leave blank to use system default. Scripts auto-detect certifi if available.
# JQA_SSL_CERT_FILE=/path/to/cacert.pem
# JQA_REQUESTS_CA_BUNDLE=/path/to/cacert.pem


# ── graph-rag Enrichment LLM call limits (optional - by default unlimited) ─────────────────────────────────────────
# If the limit is reached: LLM call is silently ignored (return ""), DEBUG log indicates the quota and the variable to modify
# Counters are reset automatically at each run_rag_passes()
# Not defined or 0 = unlimited
#JQA_METHOD_ANALYZER_MAX_LLM_CALL=10
#JQA_METHOD_SUMMARIZER_MAX_LLM_CALL=10
# Only analyze methods with cyclomatic complexity > MIN (default: 6). Set 0 to disable.
JQA_METHOD_MIN_CYCLOMATIC=6
#JQA_TYPE_SUMMARIZER_MAX_LLM_CALL=10
#JQA_SOURCE_FILE_SUMMARIZER_MAX_LLM_CALL=10
#JQA_DIRECTORY_SUMMARIZER_MAX_LLM_CALL=10
#JQA_PACKAGE_SUMMARIZER_MAX_LLM_CALL=10
#JQA_PROJECT_SUMMARIZER_MAX_LLM_CALL=10
# fallback for all others
JQA_MAX_LLM_CALL=0
