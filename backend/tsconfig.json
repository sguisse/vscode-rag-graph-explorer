{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "moduleResolution": "nodenext",
    "outDir": "../dist-backend",
    "lib": ["ES2022"],
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "rootDir": "..",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "./src/**/*",
    "../shared/**/*"
, "../webview/src/services/view/constants/graph.constants.ts"  ],
  "exclude": [
    "node_modules"
  ]
}
