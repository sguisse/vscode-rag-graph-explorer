    "build:backend": "npm run generate:code && tsc -p backend/tsconfig.json",
    "build:webview": "cd webview && npm run build",
    "build": "npm run build:backend && npm run build:webview",
    "watch:backend": "tsc -watch -p backend/tsconfig.json",
    "watch:webview": "cd webview && npm run dev",
    "compile": "npm run build"
