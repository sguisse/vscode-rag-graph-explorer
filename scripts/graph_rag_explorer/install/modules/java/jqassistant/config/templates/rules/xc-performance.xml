<?xml version="1.0" encoding="UTF-8"?>
<!--
    xc-performance - heavy work (abstract labels only)
    Portable good-practice pack (copied verbatim by the installer, no {{PROJECT_NAME}} placeholder).
    Rule conventions: constraints only read, concepts write idempotently, variable-length paths are bounded, constraints return
    Element / Fqn / Detail (+ File, Line when available), parameters have safe defaults. Violations are indicated, never blocking.
-->
<jqa:jqassistant-rules xmlns:jqa="http://schema.jqassistant.org/rule/v2.9" xmlns="http://schema.jqassistant.org/rule/v2.9">

    <concept id="xc-perf:HeavyWork" abstract="true">
        <description>CPU/memory heavy or blocking method (label :HeavyWork). Provided by scripting, office, http client packs.</description>
    </concept>

    <group id="xc-performance:Default">
        <description>xc-performance - heavy work (abstract labels only)</description>
    </group>

</jqa:jqassistant-rules>
