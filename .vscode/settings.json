   "filesExporter.maxFileSizeKb": 500,
   "filesExporter.excludeExtensionsRegex": "^[^.]+$|.*\\.(?:log|tmp|lock|zip|tar|png|jpg|gif|pyc|vsix|svg)$",
   "svg.preview.background": "editor",

   // Disable automatic background fetching
   //"git.autofetch": false,
   // Stop VS Code from counting untracked files (MASSIVE speedup for large repos)
   //"git.untrackedChanges": "hidden",
   // Limit status checks to the active repository root
   //"git.repositoryScanMaxDepth": 1,
   // Use faster, native diff algorithm
   "diffEditor.renderSideBySide": true,
   // Ignore whitespace changes by default in diffs
   "diffEditor.ignoreTrimWhitespace": true,
   // Prevent VS Code from decoration-checking every untracked file
   //"git.decorations.enabled": false

}
