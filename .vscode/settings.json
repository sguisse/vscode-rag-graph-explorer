// Place your settings in this file to overwrite default and user settings.
{
	"files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/.trunk/*actions/": true,
      "**/.trunk/*logs/": true,
      "**/.trunk/*notifications/": true,
      "**/.trunk/*out/": true,
      "**/.trunk/*plugins/": true,
      "out": false,
      "dist": false
   },
	"search.exclude": {
		"out": true, // set this to false to include "out" folder in search results
		"dist": true // set this to false to include "dist" folder in search results
	},
	// Turn off tsc task auto detection since we have the necessary tasks as npm scripts
   "typescript.js/ts.autoDetect": "off",

   "yaml.schemas": {
      "file:///Users/mac-SGUISS21/.vscode-insiders/extensions/continue.continue-2.1.0-darwin-arm64/config-yaml-schema.json": [
         ".continue/**/*.yaml"
      ]
   },
   "commentTranslate.multiLineMerge": true,

   "filesExporter.exchange": [
      {
