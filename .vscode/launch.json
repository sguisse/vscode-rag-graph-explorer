{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lancer l'extension (F5)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist-backend/**/*.js"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "../../shared/*": "${workspaceFolder}/shared/*",
        "../src/*": "${workspaceFolder}/backend/src/*",
        "*": "${workspaceFolder}/*"
      },
      "preLaunchTask": "build:backend"
    }
  ]
}
