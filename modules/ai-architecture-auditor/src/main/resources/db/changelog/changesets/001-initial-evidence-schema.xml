<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-workflow-state-table" author="winston-architect">
        <createTable tableName="audit_workflow_state">
            <column name="run_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="target_repository" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="BIGINT"/>
            <column name="metadata_json" type="JSONB"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-observation-table" author="winston-architect">
        <createTable tableName="audit_observation">
            <column name="observation_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="run_id" type="VARCHAR(64)">
                <constraints nullable="false" foreignKeyName="fk_obs_run_id" references="audit_workflow_state(run_id)"/>
            </column>
            <column name="rule_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="line_start" type="INT"/>
            <column name="line_end" type="INT"/>
            <column name="symbol" type="VARCHAR(255)"/>
            <column name="snippet" type="TEXT"/>
            <column name="snippet_hash" type="VARCHAR(64)"/>
            <column name="attributes_json" type="JSONB"/>
            <column name="created_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="audit_observation" indexName="idx_obs_run_id">
            <column name="run_id"/>
        </createIndex>
        <createIndex tableName="audit_observation" indexName="idx_obs_rule_id">
            <column name="rule_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-finding-table" author="winston-architect">
        <createTable tableName="audit_finding">
            <column name="finding_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="run_id" type="VARCHAR(64)">
                <constraints nullable="false" foreignKeyName="fk_finding_run_id" references="audit_workflow_state(run_id)"/>
            </column>
            <column name="rule_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="confidence" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="component" type="VARCHAR(255)"/>
            <column name="finding_payload_json" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="audit_finding" indexName="idx_finding_run_id">
            <column name="run_id"/>
        </createIndex>
        <createIndex tableName="audit_finding" indexName="idx_finding_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>